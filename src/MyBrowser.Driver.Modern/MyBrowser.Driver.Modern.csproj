<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>MyBrowser.Driver.Modern</RootNamespace>
        <AssemblyName>MyBrowser.Driver.Modern</AssemblyName>
        <!-- Output to solution-relative bin/Runtimes/Modern -->
        <OutputPath>$(SolutionDir)bin\$(Configuration)\net8.0\Runtimes\Modern\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyBrowser.Abstractions\MyBrowser.Abstractions.csproj" />
    </ItemGroup>

    <!-- Verify output directory before build -->
    <Target Name="VerifyPhysicalIsolation" BeforeTargets="Build">
        <Message Text="Modern Driver Output: $(OutputPath)" Importance="high"/>
        <MakeDir Directories="$(OutputPath)" />
    </Target>

    <!-- Copy driver to Runtimes folder after build -->
    <Target Name="CopyToRuntimes" AfterTargets="PostBuild">
        <Copy SourceFiles="$(TargetPath)" 
              DestinationFolder="$(OutputPath)" 
              SkipUnchangedFiles="true" />
        <Message Text="Modern driver copied to: $(OutputPath)" Importance="high"/>
    </Target>
</Project>