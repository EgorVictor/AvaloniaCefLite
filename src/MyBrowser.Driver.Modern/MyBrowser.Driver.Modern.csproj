<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>MyBrowser.Driver.Modern</RootNamespace>
        <AssemblyName>MyBrowser.Driver.Modern</AssemblyName>
        <!-- 输出到 Demo 的 bin/Runtimes/Modern 目录 -->
        <OutputPath>$(MSBuildThisFileDirectory)..\MyBrowser.Demo\bin\$(Configuration)\net8.0\Runtimes\Modern\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>
    <ItemGroup>
      <Compile Remove="src\MyBrowser.Demo\bin\**" />
      <EmbeddedResource Remove="src\MyBrowser.Demo\bin\**" />
      <None Remove="src\MyBrowser.Demo\bin\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Serilog" Version="4.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
        <ProjectReference Include="..\MyBrowser.Abstractions\MyBrowser.Abstractions.csproj" />
        <ProjectReference Include="..\MyBrowser.Interop\MyBrowser.Interop.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="src\MyBrowser.Demo\" />
    </ItemGroup>

    <!-- 构建前验证输出目录 -->
    <Target Name="VerifyPhysicalIsolation" BeforeTargets="Build">
        <Message Text="Modern 驱动输出: $(OutputPath)" Importance="high" />
        <MakeDir Directories="$(OutputPath)" />
    </Target>

    <!-- 构建后将驱动和CEF资源复制到 Runtimes 文件夹 -->
    <Target Name="CopyToRuntimes" AfterTargets="PostBuild">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
        <!-- 从 cef_binary_109 目录复制 CEF 资源文件 -->
        <ItemGroup>
            <CefResourceFiles Include="$(MSBuildThisFileDirectory)..\MyBrowser.Demo\bin\Debug\net8.0\runtimes\Modern\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(CefResourceFiles)" DestinationFiles="@(CefResourceFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
        <Message Text="Modern 驱动已复制到: $(OutputPath)" Importance="high" />
    </Target>
</Project>
