<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>MyBrowser.Driver.Legacy</RootNamespace>
        <AssemblyName>MyBrowser.Driver.Legacy</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyBrowser.Abstractions\MyBrowser.Abstractions.csproj" />
    </ItemGroup>

    <!-- Build target: copy output to Demo's Runtimes folder -->
    <Target Name="CopyToRuntimes" AfterTargets="PostBuild">
        <PropertyGroup>
            <DestDir>$(SolutionDir)..\bin\$(Configuration)\net8.0\Runtimes\Legacy</DestDir>
        </PropertyGroup>
        <MakeDir Directories="$(DestDir)" />
        <ItemGroup>
            <FilesToCopy Include="$(OutputPath)**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(DestDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>
</Project>