<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <AvaloniaVersion>11.3.7</AvaloniaVersion>
        <RootNamespace>MyBrowser.Demo</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.Win32" Version="$(AvaloniaVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyBrowser.Dispatcher\MyBrowser.Dispatcher.csproj" />
        <ProjectReference Include="..\MyBrowser.Interop\MyBrowser.Interop.csproj" />
        <ProjectReference Include="..\MyBrowser.Driver.Modern\MyBrowser.Driver.Modern.csproj" />
    </ItemGroup>

    <!-- 发布时自动复制 CEF 资源文件到 Legacy 和 Modern 目录 -->
    <Target Name="CopyCefResources" BeforeTargets="Publish">
        <PropertyGroup>
            <CefSourceDir>$(MSBuildThisFileDirectory)bin\Debug\net8.0\runtimes\Modern\</CefSourceDir>
            <CefPublishDir>$(PublishDir)</CefPublishDir>
        </PropertyGroup>
        <ItemGroup>
            <CefModernFiles Include="$(CefSourceDir)**\*" />
            <CefLegacyFiles Include="$(CefSourceDir)**\*" />
        </ItemGroup>
        <!-- 复制到 Modern 目录 -->
        <Copy SourceFiles="@(CefModernFiles)" DestinationFiles="@(CefModernFiles->'$(CefPublishDir)runtimes\Modern\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
        <!-- 复制到 Legacy 目录 -->
        <Copy SourceFiles="@(CefLegacyFiles)" DestinationFiles="@(CefLegacyFiles->'$(CefPublishDir)runtimes\Legacy\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
        <Message Text="CEF resources copied to: runtimes\Modern\ and runtimes\Legacy\" Importance="high" />
    </Target>
</Project>
